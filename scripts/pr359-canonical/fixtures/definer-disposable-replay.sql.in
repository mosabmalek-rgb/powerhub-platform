-- PR359 CB-A. SYNTHETIC disposable PostgreSQL ONLY. Not a migration.
-- Executed exclusively by cb-a-definer-disposable.sh under --network none.
\set ON_ERROR_STOP on
CREATE TABLE public.sites (
 id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 tenant_id bigint NOT NULL, name text NOT NULL, code text UNIQUE NOT NULL,
 status text NOT NULL
);
CREATE TABLE public.tenant_members (
 id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 tenant_id bigint NOT NULL, user_id bigint NOT NULL,
 role text NOT NULL, is_active boolean NOT NULL
);
CREATE TABLE public.staff_profiles (
 id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 tenant_id bigint NOT NULL, site_id bigint NOT NULL,
 user_id bigint NOT NULL, role text NOT NULL, is_active boolean NOT NULL,
 UNIQUE(tenant_id,site_id,user_id,role)
);
CREATE TABLE public.tenant_subscriptions (
 id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 tenant_id bigint NOT NULL UNIQUE
);
CREATE TABLE public.generators (
 id bigint PRIMARY KEY, tenant_id bigint NOT NULL, site_id bigint NOT NULL,
 name text NOT NULL
);
CREATE TABLE public.generator_fuel_events (
 id bigint PRIMARY KEY, tenant_id bigint NOT NULL, site_id bigint NOT NULL,
 generator_id bigint NOT NULL, occurred_at timestamptz NOT NULL
);
CREATE TABLE public.generator_maintenance_work_orders (
 id bigint PRIMARY KEY, tenant_id bigint NOT NULL, site_id bigint NOT NULL,
 generator_id bigint NOT NULL,
 reported_at timestamptz, created_at timestamptz NOT NULL
);
CREATE TABLE public.delta_probe (
 tenant_id bigint NOT NULL, site_id bigint NOT NULL,
 entity_type text NOT NULL, entity_id bigint NOT NULL
);
-- This is a synthetic recorder, NOT the real downstream privileged emitter.
CREATE FUNCTION public.powerhub_emit_fuel_maintenance_delta_sync_change(
 p_tenant_id bigint, p_site_id bigint, p_entity_type text, p_entity_id bigint
) RETURNS void LANGUAGE plpgsql AS $probe$
BEGIN
 INSERT INTO public.delta_probe VALUES
 (p_tenant_id,p_site_id,p_entity_type,p_entity_id);
END
$probe$;
-- PR359_PINNED_OWNER_FUNCTION_PLACEHOLDER
-- PR359_PINNED_GENERATOR_FUNCTION_PLACEHOLDER
CREATE TRIGGER trg_powerhub_owner_subscription_main_site
 AFTER INSERT ON public.tenant_subscriptions FOR EACH ROW
 EXECUTE FUNCTION public.powerhub_ensure_owner_main_site();
CREATE TRIGGER powerhub_delta_fuel_maintenance_generator_name
 AFTER UPDATE OF name ON public.generators FOR EACH ROW
 EXECUTE FUNCTION public.powerhub_refresh_fuel_maintenance_delta_after_generator_name_up();

INSERT INTO public.tenant_members(tenant_id,user_id,role,is_active)
 VALUES (1,100,'owner',true),(2,200,'owner',true);
INSERT INTO public.tenant_subscriptions(tenant_id) VALUES (1),(2);
INSERT INTO public.tenant_subscriptions(tenant_id)
 VALUES (1) ON CONFLICT (tenant_id) DO NOTHING;
DO $check$
BEGIN
 IF (SELECT count(*) FROM public.sites)!=2
 OR (SELECT count(*) FROM public.staff_profiles)!=2
 OR EXISTS (
  SELECT 1 FROM public.staff_profiles st
  JOIN public.sites si ON si.id=st.site_id
  WHERE st.tenant_id<>si.tenant_id
 ) THEN RAISE EXCEPTION 'PR359_OWNER_SITE_SERIAL_OR_TENANT_ISOLATION_FAILED'; END IF;
END
$check$;
SELECT 'PR359_OWNER_SITE_SERIAL_AND_TWO_TENANT_ISOLATION_PASS';

INSERT INTO public.generators VALUES
 (1,1,10,'Old target'),(2,1,10,'Other'),(3,2,10,'Foreign');
INSERT INTO public.generator_fuel_events VALUES
 (1,1,10,1,'2020-01-01'::timestamptz),
 (2,2,10,3,'2030-01-01'::timestamptz);
INSERT INTO public.generator_fuel_events
 SELECT 10000+x,1,10,2,'2026-01-01'::timestamptz+x*interval '1 second'
 FROM generate_series(1,500) x;
INSERT INTO public.generator_maintenance_work_orders VALUES
 (1,1,10,1,'2020-01-01'::timestamptz,'2020-01-01'::timestamptz),
 (2,2,10,3,'2030-01-01'::timestamptz,'2030-01-01'::timestamptz);
INSERT INTO public.generator_maintenance_work_orders
 SELECT 20000+x,1,10,2,'2026-01-01'::timestamptz+x*interval '1 second',
 '2026-01-01'::timestamptz+x*interval '1 second'
 FROM generate_series(1,200) x;

-- Exact recorded trigger. Prove the expected omission under branch-first LIMIT.
UPDATE public.generators SET name='Renamed captured source' WHERE id=1;
DO $check$
BEGIN
 IF (SELECT count(*) FROM public.delta_probe)<>0
 OR (SELECT count(*) FROM public.generator_fuel_events
    WHERE tenant_id=1 AND site_id=10 AND generator_id=1)<>1
 OR (SELECT count(*) FROM public.generator_maintenance_work_orders
    WHERE tenant_id=1 AND site_id=10 AND generator_id=1)<>1
 THEN RAISE EXCEPTION 'PR359_EXPECTED_BRANCH_FIRST_LIMIT_OMISSION_NOT_REPRODUCED';
 END IF;
END
$check$;
SELECT 'PR359_CAPTURED_BRANCH_LIMIT_OMISSION_REPRODUCED';

-- PR359_LOCAL_GENERATOR_CANDIDATE_PLACEHOLDER
TRUNCATE public.delta_probe;
UPDATE public.generators SET name='Renamed isolated candidate' WHERE id=1;
DO $check$
BEGIN
 IF (SELECT count(*) FROM public.delta_probe)<>2 OR
 NOT EXISTS (SELECT 1 FROM public.delta_probe WHERE tenant_id=1 AND site_id=10
   AND entity_type='fuel_events' AND entity_id=1) OR
 NOT EXISTS (SELECT 1 FROM public.delta_probe WHERE tenant_id=1 AND site_id=10
   AND entity_type='maintenance_work_orders' AND entity_id=1) OR
 EXISTS (SELECT 1 FROM public.delta_probe WHERE tenant_id<>1 OR entity_id<>1)
 THEN RAISE EXCEPTION 'PR359_LOCAL_CANDIDATE_SCOPED_DELTA_FAILED';
 END IF;
END
$check$;
SELECT 'PR359_LOCAL_CANDIDATE_GENERATOR_FIRST_LIMIT_PASS';
TRUNCATE public.delta_probe;
UPDATE public.generators SET name=name WHERE id=1;
DO $check$
BEGIN
 IF EXISTS (SELECT 1 FROM public.delta_probe) THEN
  RAISE EXCEPTION 'PR359_NOOP_RENAME_PRODUCED_DELTA';
 END IF;
END
$check$;
SELECT 'PR359_LOCAL_CANDIDATE_NOOP_RENAME_PASS';
SELECT 'PR359_CANONICAL_BASELINE_APPROVED=FALSE';
SELECT 'PR359_STAGING_INPLACE_GO=FALSE';
SELECT 'PR359_PRODUCTION_INPLACE_GO=FALSE';
